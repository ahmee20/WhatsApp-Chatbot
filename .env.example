# ==========================================
# HubSpot CRM Integration Configuration
# ==========================================

# 1. HubSpot Private App Access Token
# See HUBSPOT_SETUP.md for step-by-step instructions on obtaining this token.
# Format typically starts with: pat-na1-xxxx or pat-eu1-xxxx
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# 2. Server Port for the Backend Proxy
PORT=3001

# 3. HubSpot Custom Contact Property Internal Names
# By default in HubSpot, custom properties use snake_case internal names.
# Adjust these names if your custom properties were named differently:
HUBSPOT_PROP_SERVICE=services
HUBSPOT_PROP_COST=service_cost
HUBSPOT_PROP_BOOKING_DATE=booking_date
HUBSPOT_PROP_BOOKING_STATUS=booking_status

# 4. Fallback to Demo / Mock Data if no token is provided or invalid
USE_MOCK_FALLBACK=true
